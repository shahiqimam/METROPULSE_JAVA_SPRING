POSTGRES_DB=metropulse
POSTGRES_USER=metropulse
POSTGRES_PASSWORD=metropulse
SPRING_PROFILES_ACTIVE=local
METROPULSE_INGEST_KEY=change-me
# At least 32 bytes. The development default is well known and must not be used anywhere real.
METROPULSE_JWT_SECRET=metropulse-development-signing-secret-change-me
METROPULSE_ALLOWED_ORIGINS=http://localhost:4200
METROPULSE_SIMULATOR_SCENARIO=NORMAL_OPERATION
METROPULSE_SIMULATOR_SEED=42
METROPULSE_SIMULATOR_INTERVAL=PT2S
